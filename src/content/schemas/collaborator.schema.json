{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creativebridge.dev/schemas/collaborator/v0.1.json",
  "title": "Creative Bridge Collaborator",
  "type": "object",
  "additionalProperties": false,
  "required": ["creativeBridge", "displayName", "roles"],
  "properties": {
    "displayName": {
      "type": "string",
      "minLength": 1,
      "description": "Public name or professional moniker."
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "email": { "type": "string", "format": "email" },
        "url": { "type": "string", "format": "uri" }
      },
      "description": "Optional professional contact channels."
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "lead",
          "editor",
          "contributor",
          "mentor",
          "producer",
          "reviewer",
          "rights",
          "other"
        ]
      },
      "description": "Functional roles on a Bridge-aligned project."
    },
    "creativeBridge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "creditPreferences"],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "pattern": "^0\\.1\\.\\d+$",
          "description": "Semantic version for this schema document."
        },
        "creditPreferences": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attributionName", "attributionVisibility"],
          "properties": {
            "attributionName": {
              "type": "string",
              "minLength": 1,
              "description": "Preferred string for credits."
            },
            "attributionVisibility": {
              "type": "string",
              "enum": ["public", "team-only", "private-to-project"],
              "description": "How widely attribution may be shown."
            }
          }
        },
        "assistBoundaryNotes": {
          "type": "string",
          "description": "Optional free-text boundaries for how this collaborator’s work may be machine-assisted."
        }
      }
    }
  }
}
